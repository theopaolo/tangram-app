# Turso (libSQL) database — content + admin users.
# Local dev can use a plain SQLite file instead of a remote Turso DB:
#   TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob read/write token — image uploads from /admin.
# (Vercel injects it automatically once a Blob store is attached to the project;
# copy it here for local dev if you want uploads to work locally.)
BLOB_READ_WRITE_TOKEN=
